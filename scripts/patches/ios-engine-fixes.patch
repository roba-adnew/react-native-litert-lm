 using json = nlohmann::ordered_json;
 
+// Simple helper: format a conversation from JSON messages into a plain prompt
+// string, without relying on Jinja2 templates. Mirrors the start_of_turn /
+// end_of_turn structure that Gemma's tokenizer expects.
+static std::string SimpleFormatMessages(const json& messages,
+                                         const std::string& bos_token,
+                                         const std::string& eos_token,
+                                         bool add_generation_prompt) {
+  std::string result;
+  if (!bos_token.empty()) {
+    result += bos_token;
+  }
+  if (messages.is_array()) {
+    for (const auto& msg : messages) {
+      std::string role = msg.value("role", "user");
+      std::string content;
+      if (msg.contains("content")) {
+        if (msg["content"].is_string()) {
+          content = msg["content"].get<std::string>();
+        } else if (msg["content"].is_array()) {
+          // Typed content: extract text and insert media tokens.
+          for (const auto& block : msg["content"]) {
+            std::string type = block.value("type", "");
+            if (type == "text") {
+              content += block.value("text", "");
+            } else if (type == "image") {
+              content += "\n\n<start_of_image>";
+            } else if (type == "audio") {
+              content += "\n\n<start_of_audio>";
+            }
+          }
+        }
+      }
+      result += "<start_of_turn>" + role + "\n" + content + "<end_of_turn>\n";
+    }
+  }
+  if (add_generation_prompt) {
+    result += "<start_of_turn>model\n";
+  }
+  return result;
+}
