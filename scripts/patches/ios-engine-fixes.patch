   return llm_impl;
 };
 
-LITERT_LM_REGISTER_ENGINE(EngineFactory::EngineType::kLiteRTCompiledModel,
-                          [](EngineSettings settings,
-                             absl::string_view input_prompt_as_hint) {
-                            return EngineImpl::Create(std::move(settings),
-                                                      input_prompt_as_hint);
-                          });
 }  // namespace
+
+// iOS dead-strip workaround.
+//
+// LITERT_LM_REGISTER_ENGINE expands to a static EngineRegisterer object whose
+// constructor side-effects register an engine factory. On Linux/Android the
+// linker loads every translation unit in the static archive and the registerer
+// runs at process startup. On iOS, ld64 dead-strips static globals that no
+// other translation unit references — so when this .o lives inside a static
+// archive (libengine-device.a) and the only consumer is the C API in
+// `c/engine.cc`, the registerer never runs, EngineFactory::CreateDefault
+// returns "no engine type registered", and `litert_lm_engine_create` returns
+// NULL with no actionable error.
+//
+// We pull the registerer out of the anonymous namespace, give it an explicit
+// name, and expose `ForceLinkEngineImpl()` which references it via a volatile
+// load. `litert_lm_engine_create` calls this function once before any factory
+// lookup, which forces the linker to keep `kEngineRegisterer` (and therefore
+// `engine_impl.o`) in the final binary.
+//
+// Same pattern applies to any future engine implementation .cc files that get
+// added to the OSS source tree.
+static const ::litert::lm::EngineRegisterer kEngineRegisterer(
+    EngineFactory::EngineType::kLiteRTCompiledModel,
+    [](EngineSettings settings, absl::string_view input_prompt_as_hint) {
+      return EngineImpl::Create(std::move(settings), input_prompt_as_hint);
+    });
+
 }  // namespace litert::lm
+
+extern "C" void ForceLinkEngineImpl() {
+  // Volatile read so the optimizer can't elide the reference.
+  volatile const void* p = &::litert::lm::kEngineRegisterer;
+  (void)p;
+}
