+// Defined in runtime/core/engine_impl.cc to defeat iOS linker dead-strip on
+// the engine registerer. Call before any EngineFactory lookup. See the
+// comment block in engine_impl.cc for full rationale.
+extern "C" void ForceLinkEngineImpl();
+
 LiteRtLmEngine* litert_lm_engine_create(
     const LiteRtLmEngineSettings* settings) {
+  ForceLinkEngineImpl();
+
   if (!settings || !settings->settings) {
     return nullptr;
   }
